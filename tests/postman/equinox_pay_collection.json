              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Invoice slug generated', function() { pm.expect(data.slug).to.match(/^inv_/); });",
                  "pm.test('Status is PENDING', function() { pm.expect(data.status).to.eql('PENDING'); });",
