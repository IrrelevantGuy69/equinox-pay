                  "    var exp = new Date(data.expiresAt).getTime();",
                  "    var now = Date.now();",
                  "    var diffHours = (exp - now) / (1000 * 3600);",
                  "    pm.expect(diffHours).to.be.above(23.8);",
                  "    pm.expect(diffHours).to.be.below(24.2);",
                  "});",
                  "pm.environment.set('invoice_slug', data.slug);"
