        {
          "name": "1.3 Core Transfer - Successful Peer-to-Peer Settlement",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('transfer_idempotency_key', 'pm_tx_' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('State transitioned to SETTLED', function() { pm.expect(data.status).to.eql('SETTLED'); });",
                  "pm.test('Payment ID generated', function() { pm.expect(data.paymentId).to.be.a('string'); });",
                  "pm.test('Amount matches', function() { pm.expect(data.amount).to.eql(15.00); });",
